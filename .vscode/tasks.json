{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cargo run"
      ],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "golf-api",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling|Finished|Running",
          "endsPattern": "listening on http://127\\.0\\.0\\.1:8787"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "golf-strategy"
      }
    },
    {
      "label": "Web",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "golf-web",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "golf-strategy"
      }
    },
    {
      "label": "Start API and web",
      "dependsOn": ["API", "Web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "cargo build",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cargo build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cargo test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
